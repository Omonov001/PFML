{
  "Print statement": {
    "prefix": "pri",
    "body": ["print(${1:value});"],
    "description": "Print a value"
  },
  "If Else block": {
    "prefix": "if",
    "body": [
      "if (${1:condition}) {",
      "    ${2:print(\"Success!\");}",
      "} else {",
      "    ${3:print(\"Failed!\");}",
      "}"
    ],
    "description": "Create an if/else block"
  },
  "Else block": {
    "prefix": "els",
    "body": ["else {", "    ${1:print(\"Failed!\");}", "}"],
    "description": "Create an else block"
  },
  "Mutable variable": {
    "prefix": "let",
    "body": ["let ${1:name} = ${2:value};"],
    "description": "Declare a mutable variable"
  },
  "Constant variable": {
    "prefix": "const",
    "body": ["const ${1:name} = ${2:value};"],
    "description": "Declare an immutable variable"
  },
  "Input statement": {
    "prefix": "inp",
    "body": ["input(\"${1:Enter value: }\")"],
    "description": "Read user input"
  }
}
