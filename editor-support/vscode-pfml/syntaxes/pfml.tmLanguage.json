{
  "scopeName": "source.pfml",
  "patterns": [
    {
      "name": "comment.line.double-slash.pfml",
      "match": "//.*$"
    },
    {
      "name": "string.quoted.double.pfml",
      "begin": "\"",
      "end": "\"",
      "patterns": [
        {
          "name": "constant.character.escape.pfml",
          "match": "\\\\."
        }
      ]
    },
    {
      "name": "keyword.control.pfml",
      "match": "\\b(if|else)\\b"
    },
    {
      "name": "storage.type.pfml",
      "match": "\\b(let|const)\\b"
    },
    {
      "name": "constant.language.boolean.pfml",
      "match": "\\b(true|false)\\b"
    },
    {
      "name": "support.function.pfml",
      "match": "\\b(print|input)\\b(?=\\s*\\()"
    },
    {
      "name": "variable.other.pfml",
      "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
    },
    {
      "name": "constant.numeric.pfml",
      "match": "\\b\\d+(\\.\\d+)?\\b"
    },
    {
      "name": "keyword.operator.logical.pfml",
      "match": "&&|\\|\\||\\b(and|or)\\b"
    },
    {
      "name": "keyword.operator.comparison.pfml",
      "match": "==|!=|>=|<=|[<>]"
    },
    {
      "name": "keyword.operator.arithmetic.pfml",
      "match": "[+*/%\\-]"
    },
    {
      "name": "keyword.operator.assignment.pfml",
      "match": "="
    },
    {
      "name": "punctuation.section.block.begin.pfml",
      "match": "\\{"
    },
    {
      "name": "punctuation.section.block.end.pfml",
      "match": "\\}"
    },
    {
      "name": "punctuation.pfml",
      "match": "[();,]"
    }
  ],
  "repository": {},
  "fileTypes": ["pfml"],
  "name": "PFML"
}
